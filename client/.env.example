# ค่านี้เป็น URL ของ API ที่ browser จะเรียกตรงๆ
# ถ้าขึ้น Vercel และต้องการให้ frontend proxy ผ่าน /api ให้ปล่อยว่างได้เลย
# ตัวอย่าง local: http://localhost:5000
NEXT_PUBLIC_API_URL=

# ค่านี้เป็น URL หลักของฝั่งเว็บสำหรับใช้สร้างลิงก์ canonical, metadata และ callback ต่างๆ
# ตอนพัฒนาในเครื่องใช้ http://localhost:3000
# ตอนขึ้น Vercel ให้ใส่โดเมนของ frontend เช่น https://nucare-web.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ค่านี้ Next.js ใช้ฝั่ง server เท่านั้น เพื่อ rewrite /api/* ไปยัง backend จริง
# ตอนพัฒนาในเครื่องให้ชี้ไป server local เช่น http://localhost:5000
# ตอนขึ้น Vercel ให้ใส่โดเมนของ backend เช่น https://nucare-api.vercel.app
NUCARE_API_PROXY_URL=http://localhost:5000
