# ชื่อฐานข้อมูล PostgreSQL ที่จะสร้างในสภาพแวดล้อม production แบบ Docker
NUCARE_POSTGRES_DB=nucare

# ชื่อผู้ใช้ PostgreSQL สำหรับสภาพแวดล้อม production แบบ Docker
NUCARE_POSTGRES_USER=nucare

# URL สาธารณะของ frontend จริง เช่นโดเมนเว็บที่ผู้ใช้เข้าใช้งาน
NUCARE_PUBLIC_APP_ORIGIN=https://app.example.go.th

# URL สาธารณะของ backend API จริง
NUCARE_PUBLIC_API_ORIGIN=https://api.example.go.th

# พอร์ตของ service ฝั่ง server ภายในเครื่อง/host ที่รัน Docker production
NUCARE_SERVER_PORT=5000

# พอร์ตของ service ฝั่ง client ภายในเครื่อง/host ที่รัน Docker production
NUCARE_CLIENT_PORT=3000

# จำนวน reverse proxy ที่ระบบ backend ควรเชื่อถือใน production
NUCARE_TRUST_PROXY_HOPS=1

# ขนาดสูงสุดของ JSON body ที่ API ยอมรับ
NUCARE_JSON_BODY_LIMIT=1mb

# ช่วงเวลาจำกัดจำนวน request รวมของ API หน่วยเป็นมิลลิวินาที
NUCARE_API_RATE_LIMIT_WINDOW_MS=60000

# จำนวน request รวมสูงสุดต่อ IP ภายในช่วงเวลาข้างบน
NUCARE_API_RATE_LIMIT_MAX=5000

# ช่วงเวลาจำกัด request ที่เปลี่ยนแปลงข้อมูล เช่น POST/PUT/PATCH/DELETE
NUCARE_API_WRITE_RATE_LIMIT_WINDOW_MS=60000

# จำนวน request เปลี่ยนแปลงข้อมูลสูงสุดต่อ IP ภายในช่วงเวลาข้างบน
NUCARE_API_WRITE_RATE_LIMIT_MAX=2000

# อายุของลิงก์รีเซ็ตรหัสผ่าน หน่วยเป็นนาที
NUCARE_PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=5

# ช่วงเวลาจำกัดการลองล็อกอิน หน่วยเป็นมิลลิวินาที
NUCARE_AUTH_RATE_LIMIT_WINDOW_MS=900000

# จำนวนครั้งสูงสุดที่ลองล็อกอินได้ภายในช่วงเวลาข้างบน
NUCARE_AUTH_RATE_LIMIT_MAX=10

# ช่วงเวลาจำกัดการส่งแบบประเมิน หน่วยเป็นมิลลิวินาที
NUCARE_ASSESSMENT_RATE_LIMIT_WINDOW_MS=3600000

# จำนวนครั้งสูงสุดที่ส่งแบบประเมินได้ภายในช่วงเวลาข้างบน
NUCARE_ASSESSMENT_RATE_LIMIT_MAX=30

# ช่วงเวลาจำกัดการส่งแบบสอบถาม หน่วยเป็นมิลลิวินาที
NUCARE_SURVEY_RATE_LIMIT_WINDOW_MS=3600000

# จำนวนครั้งสูงสุดที่ยอมให้ส่งแบบสอบถามได้ภายในช่วงเวลาข้างบน ต่อผู้ใช้ที่ล็อกอิน
NUCARE_SURVEY_RATE_LIMIT_MAX=60

# ช่วงเวลาจำกัดการแจ้งเหตุฉุกเฉิน หน่วยเป็นมิลลิวินาที
NUCARE_SOS_RATE_LIMIT_WINDOW_MS=600000

# จำนวนครั้งสูงสุดที่แจ้งเหตุฉุกเฉินได้ภายในช่วงเวลาข้างบน
NUCARE_SOS_RATE_LIMIT_MAX=3

# ช่วงเวลาจำกัดการส่งคำขอรับคำปรึกษา หน่วยเป็นมิลลิวินาที
NUCARE_CONSULTATION_REQUEST_RATE_LIMIT_WINDOW_MS=3600000

# จำนวนครั้งสูงสุดที่ส่งคำขอรับคำปรึกษาได้ภายในช่วงเวลาข้างบน
NUCARE_CONSULTATION_REQUEST_RATE_LIMIT_MAX=10

# จำนวนรอบ bcrypt สำหรับการ import นักศึกษา
NUCARE_STUDENT_IMPORT_BCRYPT_ROUNDS=12

# จำนวนงาน import นักศึกษาที่ให้ประมวลผลพร้อมกัน
NUCARE_STUDENT_IMPORT_CONCURRENCY=4

# ชื่อ host ของ SMTP สำหรับ production
NUCARE_SMTP_HOST=smtp.example.go.th

# พอร์ตของ SMTP ใน production
NUCARE_SMTP_PORT=587

# ใส่ true ถ้า SMTP production ใช้ secure connection ตั้งแต่เริ่ม
NUCARE_SMTP_SECURE=true

# อีเมลหรือ username ที่ใช้ล็อกอิน SMTP
NUCARE_SMTP_USER=no-reply@example.go.th

# ชื่อผู้ส่งที่จะปรากฏในอีเมลที่ระบบส่งออก
NUCARE_SMTP_FROM=NUCARE Support <no-reply@example.go.th>

# เปิด seed ผู้ใช้ตัวอย่างอัตโนมัติหรือไม่
NUCARE_ENABLE_DEFAULT_USER_SEED=false

# อนุญาตให้ seed ผู้ใช้ตัวอย่างใน production ได้หรือไม่
NUCARE_ALLOW_DEFAULT_USER_SEED_IN_PRODUCTION=false

# path ไปยังไฟล์ secret ที่เก็บรหัสผ่าน PostgreSQL จริง
NUCARE_POSTGRES_PASSWORD_SECRET_FILE=./secrets/examples/postgres_password.example.txt

# path ไปยังไฟล์ secret ที่เก็บ DATABASE_URL จริง
NUCARE_DATABASE_URL_SECRET_FILE=./secrets/examples/database_url.example.txt

# path ไปยังไฟล์ secret ที่เก็บ JWT access secret จริง
NUCARE_JWT_ACCESS_SECRET_FILE=./secrets/examples/jwt_access_secret.example.txt

# path ไปยังไฟล์ secret ที่เก็บ JWT refresh secret จริง
NUCARE_JWT_REFRESH_SECRET_FILE=./secrets/examples/jwt_refresh_secret.example.txt

# path ไปยังไฟล์ secret ที่เก็บรหัสผ่าน SMTP จริง
NUCARE_SMTP_PASSWORD_SECRET_FILE=./secrets/examples/smtp_password.example.txt
