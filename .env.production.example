NUCARE_POSTGRES_DB=nucare
NUCARE_POSTGRES_USER=nucare

NUCARE_PUBLIC_APP_ORIGIN=https://app.example.go.th
NUCARE_PUBLIC_API_ORIGIN=https://api.example.go.th

NUCARE_SERVER_PORT=5000
NUCARE_CLIENT_PORT=3000
NUCARE_TRUST_PROXY_HOPS=1
NUCARE_JSON_BODY_LIMIT=2mb

NUCARE_PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=5
NUCARE_AUTH_RATE_LIMIT_WINDOW_MS=900000
NUCARE_AUTH_RATE_LIMIT_MAX=10
NUCARE_ASSESSMENT_RATE_LIMIT_WINDOW_MS=3600000
NUCARE_ASSESSMENT_RATE_LIMIT_MAX=30
NUCARE_SOS_RATE_LIMIT_WINDOW_MS=600000
NUCARE_SOS_RATE_LIMIT_MAX=3
NUCARE_STUDENT_IMPORT_BCRYPT_ROUNDS=12
NUCARE_STUDENT_IMPORT_CONCURRENCY=4

NUCARE_SMTP_HOST=smtp.example.go.th
NUCARE_SMTP_PORT=587
NUCARE_SMTP_SECURE=true
NUCARE_SMTP_USER=no-reply@example.go.th
NUCARE_SMTP_FROM=NUCARE Support <no-reply@example.go.th>

NUCARE_ENABLE_DEFAULT_USER_SEED=false
NUCARE_ALLOW_DEFAULT_USER_SEED_IN_PRODUCTION=false

NUCARE_POSTGRES_PASSWORD_SECRET_FILE=./secrets/examples/postgres_password.example.txt
NUCARE_DATABASE_URL_SECRET_FILE=./secrets/examples/database_url.example.txt
NUCARE_JWT_ACCESS_SECRET_FILE=./secrets/examples/jwt_access_secret.example.txt
NUCARE_JWT_REFRESH_SECRET_FILE=./secrets/examples/jwt_refresh_secret.example.txt
NUCARE_SMTP_PASSWORD_SECRET_FILE=./secrets/examples/smtp_password.example.txt
