\tr@field{titleTH}{ชื่อระบบ}
\tr@field{titleEN}{System Title}
\tr@field{doctype}{รายงานการทดสอบ}
\tr@field{systemUnderTest}{ระบบเว็บแอปพลิเคชัน}
\tr@field{systemVersion}{1.0}
\tr@field{testerName}{ชื่อผู้ทดสอบ}
\tr@field{testDateTH}{วันที่ \ldots\ เดือน พ.ศ.\ \ldots}
\tr@field{advisorTH}{อาจารย์ที่ปรึกษา}
\tr@field{courseCode}{รหัสวิชา}
\tr@field{courseName}{ชื่อวิชา}
\tr@field{semester}{1}
\tr@field{academicYearTH}{2568}
\tr@field{submitMonthTH}{ตุลาคม}
\tr@field{submitYearTH}{2568}
\tr@field{firstStudentID}{6xxxxxxxx-x}
