  BoldFont=lmmono10-regular.otf,
  ItalicFont=lmmono10-regular.otf,
  BoldItalicFont=lmmono10-regular.otf]

\renewcommand\UrlFont{\ttfamily}
\hypersetup{colorlinks=true, linkcolor=black, urlcolor=blue!50!black, citecolor=black}

% โค้ด/พาธที่ตัดบรรทัดได้ในตาราง (ห้ามใช้ \texttt กับสตริงยาวในเซลล์)
\newcommand{\tccode}[1]{%
  {\fontsize{9}{11}\selectfont\ttfamily\nolinkurl{#1}}}

% ---------------------------------------------------------------------
