    Ligatures=TeX]%
  \setsansfont{THSarabunNew}[
    Path=\tr@fontpath, Extension=.ttf,
    UprightFont=*-Regular, BoldFont=*-Bold,
    ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic,
    Ligatures=TeX]%
}{%
  \PackageError{testreport}{ไม่พบฟอนต์ theme/fonts/THSarabunNew-Regular.ttf}
    {คัดลอก TH Sarabun New จาก Template_Manual_2026_1/theme/fonts/}}

