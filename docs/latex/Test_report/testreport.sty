      สาขาวิชาวิทยาการคอมพิวเตอร์\\
      วิทยาลัยการคอมพิวเตอร์ มหาวิทยาลัยขอนแก่น\\[0.6em]
      (\@submitMonthTH\ \@submitYearTH)\par}
  \end{center}%
  \clearpage}

% ---------------------------------------------------------------------
% ตารางสถานการณ์ทดสอบ — รูปแบบตามเล่มอ้างอิง
%   หน้าแรก: คำบรรยาย + meta 4 คอลัมน์ + หัวเคสเทา + แถวเคส (ติดกันเป็นตารางเดียว)
%   หน้าถัดไป: ``ตารางที่ N สถานการณ์ทดสอบที่ M (ต่อ)'' + หัวเคส + แถวที่เหลือ
%
% \begin{testscenario}{เลขตาราง}{เลขสถานการณ์}
%   \tcmeta{TC01}{CS2-1}{ชื่อโปรแกรม}{ผู้ทดสอบ}{วันที่ทดสอบ}{1.0}
%   \tcname{...}\tcpre{...}\tcdesc{...}
%   \tccase{1}{กรณี}{\begin{tcsteps}\item ...\end{tcsteps}}{คาดหวัง}{จริง}{Pass}
%   \tccasecont{2 (ต่อ)}{\begin{tcsteps}\setcounter{enumi}{4}\item ...\end{tcsteps}}
% \end{testscenario}
% ---------------------------------------------------------------------
\newcommand{\tc@id}{}
\newcommand{\tc@project}{}
\newcommand{\tc@program}{}
\newcommand{\tc@tester}{}
\newcommand{\tc@date}{}
\newcommand{\tc@version}{}
\newcommand{\tc@name}{}
\newcommand{\tc@pre}{}
\newcommand{\tc@desc}{}
\newcommand{\tc@cases}{}
\newcommand{\tc@tablenum}{}
\newcommand{\tc@scenarionum}{}

\newlength{\tc@wLabel}
\newlength{\tc@wLabelB}
\newlength{\tc@wVal}
\newlength{\tc@wValB}
\newlength{\tc@wSpan}
\newlength{\tc@wA}
\newlength{\tc@wB}
\newlength{\tc@wC}
\newlength{\tc@wD}
\newlength{\tc@wE}
\newlength{\tc@wF}

\newcommand{\tc@setwidths}{%
  \setlength{\tabcolsep}{4pt}%
  \setlength{\tc@wLabel}{3.6cm}%
  \setlength{\tc@wLabelB}{2.3cm}%
  \setlength{\tc@wVal}{\dimexpr0.5\textwidth-0.5\tc@wLabel-0.5\tc@wLabelB-4\tabcolsep-2.5\arrayrulewidth\relax}%
  \setlength{\tc@wValB}{\tc@wVal}%
  \setlength{\tc@wSpan}{\dimexpr\textwidth-\tc@wLabel-4\tabcolsep-2\arrayrulewidth\relax}%
  \setlength{\tc@wA}{1.15cm}%
  \setlength{\tc@wB}{2.7cm}%
  \setlength{\tc@wD}{2.55cm}%
  \setlength{\tc@wE}{2.55cm}%
  \setlength{\tc@wF}{1.45cm}%
  \setlength{\tc@wC}{\dimexpr\textwidth-\tc@wA-\tc@wB-\tc@wD-\tc@wE-\tc@wF-12\tabcolsep-7\arrayrulewidth\relax}%
}

\newcommand{\tcmeta}[6]{%
  \gdef\tc@id{#1}\gdef\tc@project{#2}%
  \gdef\tc@program{#3}\gdef\tc@tester{#4}%
  \gdef\tc@date{#5}\gdef\tc@version{#6}}
\newcommand{\tcname}[1]{\gdef\tc@name{#1}}
\newcommand{\tcpre}[1]{\gdef\tc@pre{#1}}
\newcommand{\tcdesc}[1]{\gdef\tc@desc{#1}}

\newcommand{\tccase}[6]{%
  \gappto\tc@cases{%
    #1 & #2 & #3 & #4 & #5 & #6 \tabularnewline
    \hline
  }}

% แถวต่อเนื่องของกรณีเดิม (เช่น ลำดับ = ``2 (ต่อ)'' มีเฉพาะขั้นตอน — คอลัมน์อื่นว่าง)
\newcommand{\tccasecont}[2]{%
  \gappto\tc@cases{%
    #1 & & #2 & & & \tabularnewline
    \hline
  }}

% บังคับขึ้นหน้าใหม่กลางตารางเคส (ใช้คู่กับ \tccasecont ให้ได้หน้า ``(ต่อ)'' แบบเล่มอ้างอิง)
\newcommand{\tccasebreak}{%
  \gappto\tc@cases{\pagebreak}}

\newcommand{\tc@printmeta}{%
  \noindent
  \begin{tabular}{|L{\tc@wLabel}|L{\tc@wVal}|L{\tc@wLabelB}|L{\tc@wValB}|}
    \hline
    รหัสสถานการณ์ทดสอบ & \tc@id & รหัสโครงงาน & \tc@project \\
    \hline
    โปรแกรมที่อยู่ระหว่างทดสอบ & \tc@program & ผู้ทดสอบ & \tc@tester \\
    \hline
    วันที่ทดสอบ & \tc@date & เวอร์ชัน & \tc@version \\
    \hline
    ชื่อสถานการณ์การทดสอบ &
      \multicolumn{3}{L{\tc@wSpan}|}{\tc@name} \\
    \hline
    ข้อกำหนดเบื้องต้น &
      \multicolumn{3}{L{\tc@wSpan}|}{\tc@pre} \\
    \hline
    คำอธิบาย &
      \multicolumn{3}{L{\tc@wSpan}|}{\tc@desc} \\
    \hline
  \end{tabular}%
}

\newcommand{\tc@caseheader}{%
  \rowcolor{tcHeader}%
  \centering\textbf{ลำดับ} &
  \centering\textbf{กรณีทดสอบ} &
  \centering\textbf{ขั้นตอน} &
  \centering\textbf{ผลลัพธ์ที่คาดหวัง} &
  \centering\textbf{ผลลัพธ์จริง} &
  \centering\textbf{ผลการทดสอบ} \tabularnewline
  \hline
}

\newcommand{\tc@printcases}{%
  \setlength{\LTleft}{0pt}%
  \setlength{\LTright}{0pt}%
  \setlength{\LTpre}{0pt}%
  \setlength{\LTpost}{0.6em}%
  \noindent
  \begin{longtable}{|M{\tc@wA}|L{\tc@wB}|L{\tc@wC}|L{\tc@wD}|L{\tc@wE}|M{\tc@wF}|}
    \hline
    \tc@caseheader
    \endfirsthead
    \multicolumn{6}{@{}l@{}}{%
      \textbf{ตารางที่ \tc@tablenum\ สถานการณ์ทดสอบที่ \tc@scenarionum\ (ต่อ)}}\\[0.45em]
    \hline
    \tc@caseheader
    \endhead
    \tc@cases
  \end{longtable}%
}

\newenvironment{testscenario}[2]{%
  \gdef\tc@cases{}%
  \gdef\tc@id{}\gdef\tc@project{}%
  \gdef\tc@program{}\gdef\tc@tester{}%
  \gdef\tc@date{}\gdef\tc@version{}%
  \gdef\tc@name{}\gdef\tc@pre{}\gdef\tc@desc{}%
  \gdef\tc@tablenum{#1}%
  \gdef\tc@scenarionum{#2}%
}{%
  \par\addvspace{1.0em}%
  \begingroup
  \setstretch{1}%
  \tc@setwidths
  \tccellpad
  \noindent\textbf{ตารางที่ \tc@tablenum\ สถานการณ์ทดสอบที่ \tc@scenarionum}\par
  \vspace{0.4em}%
  \tc@printmeta
  \par\vspace{-\arrayrulewidth}%
  \tc@printcases
  \endgroup
  \par\addvspace{0.3em}%
}

\newcommand{\tcuseDefaults}{%
  \tcmeta{TCxx}{\@projectCode}{\@systemUnderTest}{\@testerName}{\@testDateTH}{\@systemVersion}}
