\newcommand\tr@ifempty[3]{%
  \expandafter\ifx\expandafter\relax\detokenize\expandafter{#1}\relax#2\else#3\fi}
\newcommand*\tr@ifsecond{\tr@ifempty{\@secondStudentID}}

% ---------------------------------------------------------------------
% หน้า / ตัวอักษร
% ---------------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[R]{\thepage}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[R]{\thepage}}

\setstretch{1.15}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.4em}

\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}
\renewcommand{\tabularxcolumn}[1]{p{#1}}

% เซลล์ตาราง: ตัดบรรทัดหลวม ๆ กันล้นทับคอลัมน์ข้าง / ชิดบนเหมือนเล่มอ้างอิง
\newcolumntype{L}[1]{>{\raggedright\sloppy\setlength{\emergencystretch}{1.2em}\arraybackslash}p{#1}}
\newcolumntype{M}[1]{>{\centering\arraybackslash}p{#1}}

\definecolor{tcHeader}{gray}{0.85}
\newcommand{\tccellpad}{\renewcommand{\arraystretch}{1.3}}

% รายการขั้นตอนในเซลล์ตาราง (รูปแบบ 1. 2. 3. ตามเล่ม)
\newenvironment{tcsteps}{%
  \raggedright\sloppy
  \setlength{\emergencystretch}{1.2em}%
  \begin{enumerate}[
    leftmargin=1.2em,
    itemsep=0.08em,
    parsep=0pt,
    topsep=0.05em,
    partopsep=0pt,
    label=\arabic*.]
}{\end{enumerate}}

