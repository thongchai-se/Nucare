# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจริงของเครื่องคุณ

# URL สำหรับเชื่อมต่อฐานข้อมูล PostgreSQL/Neon ที่ Prisma และ API ใช้งาน
# ตอน local ถ้าใช้ Docker DB ที่เปิดพอร์ตไว้ ให้ใช้ localhost:5432
#
# --- Neon (เทสก่อนขึ้นเซิร์ฟเวอร์มหาวิทยาลัย) ---
# Express/local รันยาว: ใช้ **direct** (ไม่มี -pooler ใน host) + sslmode=require
#   ห้ามใส่ channel_binding=require — มักทำให้ Prisma ขึ้น Error { kind: Closed }
#   ตัวอย่าง:
#   DATABASE_URL="postgresql://USER:PASS@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Vercel/serverless: ใช้ host แบบ -pooler พร้อม pgbouncer=true (โค้ด normalize ให้เองก็ได้)
#   DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler....neon.tech/neondb?sslmode=require&pgbouncer=true"
#
# DIRECT_URL ใช้ตอน prisma migrate — ต้องเป็น direct เสมอ (ไม่มี -pooler)
# ถ้ายังไม่มี Neon ให้ชี้ DIRECT_URL ไปค่าเดียวกับ DATABASE_URL ของ local ได้
DATABASE_URL="postgresql://nucare:nucare_password@localhost:5432/nucare?schema=public"
DIRECT_URL="postgresql://nucare:nucare_password@localhost:5432/nucare?schema=public"

# ช่วง ping กัน Neon ตัด idle connection (มิลลิวินาที) — ค่าเริ่มต้น 120000 ปิดด้วยค่า < 30000
# DB_KEEPALIVE_INTERVAL_MS=120000

# secret สำหรับเซ็น access token ของระบบล็อกอิน
# ควรยาวอย่างน้อย 32 ตัวอักษร และห้ามใช้ค่าซ้ำกับ refresh token
JWT_ACCESS_SECRET=

# secret สำหรับเซ็น refresh token ของระบบล็อกอิน
# ควรยาวอย่างน้อย 32 ตัวอักษร และเก็บเป็นความลับเหมือนรหัสผ่าน
JWT_REFRESH_SECRET=

# โดเมนของ frontend ที่อนุญาตให้เรียก API และส่ง cookie ได้
# ตอน local ใช้ http://localhost:3000
# ตอนขึ้น Vercel ให้ใส่โดเมนของ frontend เช่น https://nucare-web.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# พอร์ตที่ Express server จะรันในเครื่อง local หรือ container
PORT=5000

# ชนิดผู้ให้บริการส่งอีเมลของแอป (รีเซ็ตรหัสผ่าน / แจ้งเตือน HIGH / คำขอนัด MH)
# console = เขียนลง log (ค่าเริ่มต้นตอนพัฒนา — ไม่ต้องมี SMTP)
# smtp = ส่งผ่าน SMTP มาตรฐาน — กรอก SMTP_* ด้านล่างแล้วใช้ได้ทันที
# http = POST ไป API มหาวิทยาลัย / เกตเวย์ภายนอก (แนะนำเมื่อคณะส่ง endpoint ให้)
EMAIL_PROVIDER=console

# production ห้ามใช้ console เว้นแต่ตั้งค่านี้เป็น true ชั่วคราว (staging)
# ALLOW_CONSOLE_EMAIL=false

# --- SMTP (เมื่อ EMAIL_PROVIDER=smtp) ---
# ชื่อ host ของ SMTP เช่น smtp.gmail.com หรือ smtp.office365.com
SMTP_HOST=smtp.gmail.com

# พอร์ตของ SMTP server — ปกติ 587 (STARTTLS) หรือ 465 (SMTPS)
SMTP_PORT=587

# ใส่ true ถ้า SMTP ใช้การเชื่อมต่อแบบ secure ตั้งแต่เริ่ม
# ถ้าใช้พอร์ต 587 ส่วนใหญ่จะเป็น false
SMTP_SECURE=false

# อีเมลหรือ username สำหรับล็อกอินเข้า SMTP
SMTP_USER=

# รหัสผ่านหรือ app password สำหรับ SMTP_USER
SMTP_PASS=

# ชื่อผู้ส่งที่จะแสดงในอีเมล เช่น NUCARE Support <no-reply@example.com>
# ถ้าปล่อยว่าง ระบบจะ fallback ไปใช้ SMTP_USER
SMTP_FROM=

# --- HTTP API มหาวิทยาลัย (เมื่อ EMAIL_PROVIDER=http) ---
# URL ของ endpoint รับส่งเมล (POST JSON)
EMAIL_HTTP_URL=

# Bearer token หรือค่า auth ที่ API มหาวิทยาลัยกำหนด (ถ้ามี)
EMAIL_HTTP_TOKEN=

# ชื่อ header สำหรับ token — ค่าเริ่มต้น Authorization
EMAIL_HTTP_AUTH_HEADER=Authorization

# ผู้ส่งใน payload (ถ้า API ต้องการฟิลด์ from)
EMAIL_HTTP_FROM=

# เปลี่ยนชื่อฟิลด์ใน JSON body ถ้า API มหาวิทยาลัยใช้ชื่ออื่น
# ค่าเริ่มต้น: to / subject / text / html / from
# EMAIL_HTTP_FIELD_TO=to
# EMAIL_HTTP_FIELD_SUBJECT=subject
# EMAIL_HTTP_FIELD_TEXT=text
# EMAIL_HTTP_FIELD_HTML=html
# EMAIL_HTTP_FIELD_FROM=from

# เมื่อแอดมินเปิดคลื่นแบบประเมิน — ส่งอีเมลถึงนิสิตที่ถูกมอบหมายด้วย (true/false)
# การแจ้งในแอปสร้างเสมอเมื่อเปิดคลื่น
EMAIL_NOTIFY_ON_WAVE_OPEN=false

# อายุของลิงก์รีเซ็ตรหัสผ่าน หน่วยเป็นนาที
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=5

# จำนวน reverse proxy ที่เชื่อถือได้หน้าระบบ API
# local ปกติใช้ 0
# ถ้ารันบน Vercel ให้ตั้งเป็น 1
TRUST_PROXY_HOPS=0

# ระยะเก็บ TrafficLog (วัน) — ขั้นต่ำ 90 สูงสุด 730 ตามแนวทาง พ.ร.บ.คอมฯ
TRAFFIC_LOG_RETENTION_DAYS=90

# ระยะเก็บ AuditLog (วัน) — ขั้นต่ำ 90 สูงสุด 730
AUDIT_LOG_RETENTION_DAYS=90

# ช่วง tick สร้าง/เปิดรอบแบบประเมินอัตโนมัติ (มิลลิวินาที) — ค่าเริ่มต้น 10 นาที ขั้นต่ำ 1 นาที
SURVEY_SCHEDULE_INTERVAL_MS=600000

# เวลาของเซิร์ฟเวอร์/ฐานข้อมูลควรซิงก์ NTP (chrony/systemd-timesyncd) ที่ชั้น OS
# แอปบันทึก timestamp จากนาฬิกาโฮสต์ — ไม่มี NTP ในโค้ดแอป

# ขนาดสูงสุดของ JSON body ที่ API ยอมรับ เช่น 1mb หรือ 2mb
JSON_BODY_LIMIT=4mb

# ช่วงเวลาจำกัดจำนวน request รวมของ API หน่วยเป็นมิลลิวินาที
API_RATE_LIMIT_WINDOW_MS=60000

# จำนวน request รวมสูงสุดต่อ IP ภายในช่วงเวลาข้างบน
API_RATE_LIMIT_MAX=300

# ช่วงเวลาจำกัด request ที่เปลี่ยนแปลงข้อมูล เช่น POST/PUT/PATCH/DELETE
API_WRITE_RATE_LIMIT_WINDOW_MS=60000

# จำนวน request เปลี่ยนแปลงข้อมูลสูงสุดต่อ IP ภายในช่วงเวลาข้างบน
API_WRITE_RATE_LIMIT_MAX=60

# ช่วงเวลาจำกัดการส่งแบบประเมิน หน่วยเป็นมิลลิวินาที
ASSESSMENT_RATE_LIMIT_WINDOW_MS=3600000

# จำนวนครั้งสูงสุดที่ยอมให้ส่งแบบประเมินได้ภายในช่วงเวลาข้างบน
ASSESSMENT_RATE_LIMIT_MAX=30

# ช่วงเวลาจำกัดการส่งแบบสอบถาม หน่วยเป็นมิลลิวินาที
SURVEY_RATE_LIMIT_WINDOW_MS=3600000

# จำนวนครั้งสูงสุดที่ยอมให้ส่งแบบสอบถามได้ภายในช่วงเวลาข้างบน ต่อผู้ใช้ที่ล็อกอิน
SURVEY_RATE_LIMIT_MAX=60

# ช่วงเวลาจำกัดการกดแจ้งเหตุฉุกเฉิน หน่วยเป็นมิลลิวินาที
SOS_RATE_LIMIT_WINDOW_MS=600000

# จำนวนครั้งสูงสุดที่ยอมให้กดแจ้งเหตุฉุกเฉินได้ภายในช่วงเวลาข้างบน
SOS_RATE_LIMIT_MAX=3

# ช่วงเวลาจำกัดการบันทึกความยินยอมคุกกี้ หน่วยเป็นมิลลิวินาที
CONSENT_RATE_LIMIT_WINDOW_MS=3600000

# จำนวนครั้งสูงสุดที่บันทึกความยินยอมได้ภายในช่วงเวลาข้างบน
CONSENT_RATE_LIMIT_MAX=20

# ช่วงเวลาจำกัดการส่งคำขอรับคำปรึกษา หน่วยเป็นมิลลิวินาที
CONSULTATION_REQUEST_RATE_LIMIT_WINDOW_MS=3600000

# จำนวนครั้งสูงสุดที่ส่งคำขอรับคำปรึกษาได้ภายในช่วงเวลาข้างบน
CONSULTATION_REQUEST_RATE_LIMIT_MAX=10

# ผู้ให้บริการแชทเพื่อน AI ของนิสิต
# mock = คำตอบจำลองในเครื่อง
# kku  = KKU Gen AI (อนุญาตเฉพาะ Gemini / GPT / Claude)
CHAT_PROVIDER=mock

# หมายเหตุ memory: ระบบเก็บสรุปสั้นต่อนิสิต+persona ใน StudentChatMemory (~700 ตัวอักษร)
# ไม่เก็บประวัติแชทเต็ม — รองรับนิสิตจำนวนมากโดยไม่กินพื้นที่/token เกินจำเป็น

# API key ของ KKU Gen AI (รองรับชื่อ AI_API_KEY หรือ aiapikey)
AI_API_KEY=
# aiapikey=

# Base URL ของ KKU Gen AI (OpenAI-compatible)
KKU_GEN_BASE_URL=https://gen.ai.kku.ac.th/api/v1

# โมเดลที่อนุญาตเท่านั้น เช่น gemini-3.8-flash | gpt-5.6-luna | claude-sonnet-5.5
# ถ้าระบุนอก allowlist ระบบจะถอยไป gemini-3.8-flash อัตโนมัติ
KKU_GEN_CHAT_MODEL=gemini-3.8-flash

# ช่วงเวลาจำกัดการส่งข้อความแชทนิสิต หน่วยเป็นมิลลิวินาที
STUDENT_CHAT_RATE_LIMIT_WINDOW_MS=600000

# จำนวนครั้งสูงสุดที่ส่งข้อความแชทได้ภายในช่วงเวลาข้างบน
STUDENT_CHAT_RATE_LIMIT_MAX=40

# เปิดเป็น true เฉพาะตอนต้องการให้ระบบสร้างผู้ใช้ตัวอย่างอัตโนมัติ
# บน Vercel/production ชั่วคราวสำหรับตรวจงาน แนะนำให้คงเป็น false
ENABLE_DEFAULT_USER_SEED=false

# ถ้าจะยอมให้ seed ผู้ใช้ตัวอย่างใน production ต้องตั้งค่านี้เป็น true เพิ่มอีกชั้น
# เพื่อกันการเปิด seed โดยไม่ตั้งใจในระบบจริง
ALLOW_DEFAULT_USER_SEED_IN_PRODUCTION=false

# รหัสผ่านของผู้ใช้ตัวอย่างที่จะถูกสร้างเมื่อเปิด seed
# ต้องใส่เมื่อ ENABLE_DEFAULT_USER_SEED=true หรือเมื่อ Vercel build จะรัน prisma db seed
# ควรยาวอย่างน้อย 8 ตัวอักษร
DEFAULT_SEED_PASSWORD=

# รหัสผ่านบัญชี admin จริง (adminnucare@gmail.com) สำหรับ prisma seed / seed-local-test-accounts
# ถ้าไม่ตั้ง จะถอยไปใช้ DEFAULT_SEED_PASSWORD
ADMIN_SEED_PASSWORD=

# คลังรายชื่อที่แยกไว้ ระบบหลักใช้ค่านี้ตอนขอรายชื่อผ่าน API
DIRECTORY_API_URL=http://localhost:4100
DIRECTORY_API_KEY=directory-dev-key
# ถ้าไม่ส่งคณะหรือสาขาตอนดึง ระบบจะขอเฉพาะค่านี้
DIRECTORY_FACULTY=คณะพยาบาลศาสตร์
DIRECTORY_PROGRAMS=พยาบาลศาสตรบัณฑิต
