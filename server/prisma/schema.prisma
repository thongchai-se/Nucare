generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADVISOR
  STUDENT_DEVELOPMENT
  MENTAL_HEALTH
  INSTRUCTOR
  EXECUTIVE
  ADMIN
}

enum RiskLevel {
  NORMAL
  MEDIUM
  HIGH
}

enum AssessmentInstrument {
  Q2
  ST5
  Q9
  Q8
}

enum ReferralTarget {
  STUDENT_DEVELOPMENT
  COUNSELING_CENTER
}

/// ช่องแสดงสื่อที่แอดมินจัดการได้ (หน้าแรก / หน้านิสิต)
enum SiteMediaSlot {
  HOME_HERO
  HOME_GALLERY
  STUDENT_ACTIVITY
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  CLOSED
}

enum ConsultationRequestStatus {
  PENDING
  ACCEPTED
  SCHEDULED
  CANCEL_REQUESTED
  CLOSED
  CANCELLED
}

enum ConsultationPreferredChannel {
  IN_PERSON
  ONLINE
  PHONE
  MESSAGE
}

enum ConsultationOfferStatus {
  PENDING
  ACCEPTED
  SUPERSEDED
  CANCELLED
}

enum AlertType {
  ADVISOR_FOLLOW_UP
  BEHAVIOR_REPORTED
  REFERRAL_RECEIVED
  HIGH_RISK_SCREENING
  SOS_OPENED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

enum AlertPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BehaviorSeverity {
  LOW
  MEDIUM
  HIGH
}

enum EmergencyCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum MentalHealthAppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SurveyQuestionType {
  TEXT
  TEXTAREA
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SCALE
  NUMBER
  DATE
}

/// ความถี่การเปิดคลื่นแบบประเมิน
enum SurveyFrequency {
  ONE_SHOT
  WEEKLY
  ACADEMIC_TERM
  CUSTOM_INTERVAL
}

/// หน่วยช่วงเวลาสำหรับความถี่แบบกำหนดเอง
enum SurveyScheduleUnit {
  DAYS
  WEEKS
  MONTHS
}

/// กลุ่มเป้าหมายของแบบประเมิน
enum SurveyAudienceType {
  ALL_STUDENTS
  RULE_BASED
}

/// สถานะคลื่น (รอบเปิด) ของแบบประเมิน
enum SurveyWaveStatus {
  SCHEDULED
  OPEN
  CLOSED
  CANCELLED
}

/// รหัสเครื่องมือแบบประเมิน (เลิกพึ่งชื่อเรื่องเป็นหลัก)
enum SurveyInstrumentCode {
  GHQ28
  CUSTOM
}

/// รหัสสัญญาณแนวโน้มสุขภาวะจากแชท (เก็บเฉพาะรหัส ไม่เก็บข้อความ)
enum WellnessTrendSignalCode {
  DEPRESSIVE_THEME
  ANXIETY_THEME
  ACADEMIC_STRESS
  SLEEP_DISTURBANCE
  LONELINESS_ISOLATION
  RELATIONSHIP_STRESS
  BURNOUT_FATIGUE
  SELF_HARM_CRISIS
}

model User {
  id                 String              @id @default(cuid())
  name               String
  studentId          String?             @unique
  employeeId         String?             @unique
  email              String?             @unique
  studyYear          Int?
  section            String?
  password           String
  /// บังคับเปลี่ยนรหัสผ่านหลังสร้าง/นำเข้าด้วยรหัสชั่วคราว
  mustChangePassword Boolean             @default(false)
  isActive           Boolean             @default(true)
  role               Role
  additionalRoles    Role[]              @default([])
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  studentAssessments StudentAssessment[] @relation("StudentAssessmentStudent")
  advisorCareRecords CareRecord[]        @relation("CareRecordAdvisor")
  studentCareRecords CareRecord[]        @relation("CareRecordStudent")
  advisorReferrals   CaseReferral[]      @relation("CaseReferralAdvisor")
  studentReferrals   CaseReferral[]      @relation("CaseReferralStudent")
  acceptedReferrals  CaseReferral[]      @relation("CaseReferralAcceptedBy")
  studentConsultationRequests ConsultationRequest[] @relation("ConsultationRequestStudent")
  teacherConsultationRequests ConsultationRequest[] @relation("ConsultationRequestTeacher")
  consultationScheduleOffers ConsultationScheduleOffer[] @relation("ConsultationScheduleOfferProposer")
  advisorAssignments StudentAdvisorAssignment[] @relation("AdvisorAssignments")
  studentAssignments StudentAdvisorAssignment[] @relation("StudentAssignments")
  instructorStudentAssignments StudentInstructorAssignment[] @relation("InstructorStudentAssignments")
  studentInstructorAssignments StudentInstructorAssignment[] @relation("StudentInstructorAssignments")
  consentRecords ConsentRecord[]
  instructorBehaviorRecords BehaviorRecord[] @relation("BehaviorRecordInstructor")
  studentBehaviorRecords    BehaviorRecord[] @relation("BehaviorRecordStudent")
  receivedAlerts Alert[] @relation("AlertRecipient")
  triggeredAlerts Alert[] @relation("AlertActor")
  reportedEmergencyCases EmergencyCase[] @relation("EmergencyCaseReporter")
  studentEmergencyCases  EmergencyCase[] @relation("EmergencyCaseStudent")
  mentalHealthCareRecords SpecializedCareRecord[] @relation("SpecializedCareRecordProvider")
  studentSpecializedCareRecords SpecializedCareRecord[] @relation("SpecializedCareRecordStudent")
  mentalHealthAppointmentsProvided MentalHealthAppointment[] @relation("MentalHealthAppointmentProvider")
  mentalHealthAppointmentsAsStudent MentalHealthAppointment[] @relation("MentalHealthAppointmentStudent")
  auditLogs AuditLog[] @relation("AuditLogActor")
  createdSurveys Survey[] @relation("SurveyCreator")
  surveyResponses SurveyResponse[] @relation("SurveyResponseStudent")
  surveyAssignments SurveyAssignment[] @relation("SurveyAssignmentStudent")
  wellnessTrendSummaries StudentWellnessTrendSummary[] @relation("WellnessTrendSummaryStudent")
  wellnessTrendHits StudentWellnessTrendHit[] @relation("WellnessTrendHitStudent")
  studentChatMemories StudentChatMemory[] @relation("StudentChatMemoryStudent")
}

/// บันทึกสั้นต่อนิสิต+persona สำหรับคุยต่อเนื่อง — ไม่เก็บแชทเต็ม (ประหยัดพื้นที่)
model StudentChatMemory {
  id        String   @id @default(cuid())
  studentId String
  personaId String
  /// สรุป bullet สั้น ๆ สิ่งที่นิสิตเล่า
  summary   String   @default("")
  /// หัวข้อล่าสุดสำหรับทักทายต่อ
  lastTopic String?
  turnCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation("StudentChatMemoryStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, personaId])
  @@index([studentId, updatedAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StudentAssessment {
  id        String    @id @default(cuid())
  studentId String
  instrument AssessmentInstrument
  totalScore Int
  riskLevel RiskLevel @default(NORMAL)
  assessedAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  student User @relation("StudentAssessmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  answers AssessmentAnswer[]

  @@index([studentId, assessedAt])
  @@index([studentId, instrument, assessedAt])
}

model AssessmentAnswer {
  id           String @id @default(cuid())
  assessmentId String
  questionCode String
  questionText String
  answerValue  String
  score        Int
  createdAt    DateTime @default(now())

  assessment StudentAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model CareRecord {
  id        String   @id @default(cuid())
  studentId String
  advisorId String
  careDate  DateTime
  careType  String
  topic     String
  action    String
  outcome   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation("CareRecordStudent", fields: [studentId], references: [id], onDelete: Cascade)
  advisor User @relation("CareRecordAdvisor", fields: [advisorId], references: [id], onDelete: Restrict)

  @@index([studentId, careDate])
  @@index([advisorId, createdAt])
}

model StudentAdvisorAssignment {
  id        String   @id @default(cuid())
  studentId String
  advisorId String
  assignedAt DateTime @default(now())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  advisor User @relation("AdvisorAssignments", fields: [advisorId], references: [id], onDelete: Restrict)

  @@index([advisorId, isActive])
  @@index([studentId, isActive])
}

model StudentInstructorAssignment {
  id           String   @id @default(cuid())
  studentId    String
  instructorId String
  assignedAt   DateTime @default(now())
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    User @relation("StudentInstructorAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  instructor User @relation("InstructorStudentAssignments", fields: [instructorId], references: [id], onDelete: Restrict)

  @@unique([studentId, instructorId])
  @@index([instructorId, isActive])
  @@index([studentId, isActive])
}

model ConsentRecord {
  id            String   @id @default(cuid())
  userId        String?
  anonymousId   String
  status        String
  analytics     Boolean
  policyVersion String
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([anonymousId, createdAt])
  @@index([userId, createdAt])
}

model BehaviorRecord {
  id           String   @id @default(cuid())
  studentId     String
  instructorId  String
  observedAt    DateTime
  category      String
  details       String
  severity      BehaviorSeverity @default(MEDIUM)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student User @relation("BehaviorRecordStudent", fields: [studentId], references: [id], onDelete: Cascade)
  instructor User @relation("BehaviorRecordInstructor", fields: [instructorId], references: [id], onDelete: Restrict)

  @@index([studentId, observedAt])
  @@index([instructorId, createdAt])
}

model CaseReferral {
  id               String         @id @default(cuid())
  studentId        String
  advisorId        String
  acceptedByUserId String?
  target           ReferralTarget
  reason           String
  isUrgent         Boolean        @default(false)
  status           ReferralStatus @default(PENDING)
  /// บันทึกความคืบหน้าฝั่งผู้รับเคส (เช่น งานพัฒนานิสิต)
  staffNote        String?
  /// เหตุผลเมื่อปิด/ปฏิเสธคิว
  closedReason     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  student    User  @relation("CaseReferralStudent", fields: [studentId], references: [id], onDelete: Cascade)
  advisor    User  @relation("CaseReferralAdvisor", fields: [advisorId], references: [id], onDelete: Restrict)
  acceptedBy User? @relation("CaseReferralAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  specializedCareRecords SpecializedCareRecord[]
  mentalHealthAppointments MentalHealthAppointment[]

  @@index([studentId, createdAt])
  @@index([advisorId, createdAt])
  @@index([status, createdAt])
  @@index([acceptedByUserId, status])
}

model Alert {
  id              String        @id @default(cuid())
  recipientUserId String
  actorUserId     String?
  studentId       String?
  type            AlertType
  priority        AlertPriority @default(MEDIUM)
  title           String
  message         String
  status          AlertStatus   @default(OPEN)
  dueAt           DateTime?
  sourceType      String?
  sourceId        String?
  acknowledgedAt  DateTime?
  closedAt        DateTime?
  resolutionNote  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  recipient User @relation("AlertRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User? @relation("AlertActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  consultationRequest ConsultationRequest?

  @@index([recipientUserId, status, createdAt])
  @@index([studentId, createdAt])
}

model ConsultationRequest {
  id               String                     @id @default(cuid())
  studentId        String
  teacherId        String
  alertId          String?                    @unique
  topic            String
  preferredChannel ConsultationPreferredChannel @default(IN_PERSON)
  note             String?
  status           ConsultationRequestStatus  @default(PENDING)
  advisorNote      String?
  scheduledAt      DateTime?
  scheduleLocation String?
  acceptedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  student User @relation("ConsultationRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User @relation("ConsultationRequestTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  alert   Alert? @relation(fields: [alertId], references: [id], onDelete: SetNull)
  scheduleOffers ConsultationScheduleOffer[]

  @@index([studentId, createdAt])
  @@index([teacherId, status, createdAt])
  @@index([status, createdAt])
}

/** ข้อเสนอนัดหมาย — ส่งกลับไปมาระหว่างอาจารย์กับนิสิตจนกว่าจะยอมรับทั้งสองฝ่าย */
model ConsultationScheduleOffer {
  id           String                  @id @default(cuid())
  requestId    String
  proposedById String
  proposedAt   DateTime
  location     String
  note         String?
  status       ConsultationOfferStatus @default(PENDING)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  request    ConsultationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proposedBy User                @relation("ConsultationScheduleOfferProposer", fields: [proposedById], references: [id], onDelete: Restrict)

  @@index([requestId, status, createdAt])
  @@index([proposedById, createdAt])
}

model EmergencyCase {
  id               String              @id @default(cuid())
  studentId        String
  reportedByUserId String?
  summary          String
  status           EmergencyCaseStatus @default(OPEN)
  openedAt         DateTime            @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  student User @relation("EmergencyCaseStudent", fields: [studentId], references: [id], onDelete: Cascade)
  reportedBy User? @relation("EmergencyCaseReporter", fields: [reportedByUserId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([status, openedAt])
}

model SpecializedCareRecord {
  id                String   @id @default(cuid())
  studentId         String
  mentalHealthUserId String
  referralId        String?
  sessionDate       DateTime
  summary           String
  interventionPlan  String
  confidentialNotes String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student User @relation("SpecializedCareRecordStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentalHealthUser User @relation("SpecializedCareRecordProvider", fields: [mentalHealthUserId], references: [id], onDelete: Restrict)
  referral CaseReferral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  @@index([studentId, sessionDate])
  @@index([mentalHealthUserId, createdAt])
}

model MentalHealthAppointment {
  id                 String                         @id @default(cuid())
  studentId          String
  mentalHealthUserId String
  referralId         String?
  scheduledAt        DateTime
  location           String
  note               String?
  status             MentalHealthAppointmentStatus  @default(SCHEDULED)
  cancelledAt        DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  student          User          @relation("MentalHealthAppointmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentalHealthUser User          @relation("MentalHealthAppointmentProvider", fields: [mentalHealthUserId], references: [id], onDelete: Restrict)
  referral         CaseReferral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  @@index([studentId, scheduledAt])
  @@index([mentalHealthUserId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([referralId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, createdAt])
}

model Survey {
  id             String               @id @default(cuid())
  title          String
  description    String?
  status         SurveyStatus         @default(DRAFT)
  isActive       Boolean              @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  frequency      SurveyFrequency      @default(ONE_SHOT)
  scheduleEvery  Int?
  scheduleUnit   SurveyScheduleUnit?
  audienceType   SurveyAudienceType   @default(ALL_STUDENTS)
  instrumentCode SurveyInstrumentCode @default(CUSTOM)
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  createdBy       User?                   @relation("SurveyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  questions       SurveyQuestion[]
  responses       SurveyResponse[]
  eligibilityRule SurveyEligibilityRule?
  waves           SurveyWave[]

  @@index([status, isActive])
  @@index([startsAt, endsAt])
  @@index([audienceType, frequency])
}

/// กฎคัดเลือกกลุ่มเป้าหมาย — ใช้เฉพาะฝั่งแอดมิน/เซิร์ฟเวอร์ ไม่ส่งให้นักศึกษา
model SurveyEligibilityRule {
  id                  String                    @id @default(cuid())
  surveyId            String                    @unique
  priorRiskLevels     RiskLevel[]               @default([])
  wellnessSignalCodes WellnessTrendSignalCode[] @default([])
  studyYears          Int[]                     @default([])
  sections            String[]                  @default([])
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

/// คลื่น/รอบเปิดของแบบประเมิน (รายครั้ง รายสัปดาห์ หรือรายเทอม)
model SurveyWave {
  id        String           @id @default(cuid())
  surveyId  String
  label     String
  termKey   String?
  weekStart DateTime?
  opensAt   DateTime
  closesAt  DateTime?
  status    SurveyWaveStatus @default(SCHEDULED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  survey      Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  assignments SurveyAssignment[]
  responses   SurveyResponse[]

  @@index([surveyId, status])
  @@index([opensAt, closesAt])
  @@index([status, opensAt])
}

/// สิทธิ์เข้าทำแบบในคลื่นหนึ่ง — สร้างฝั่งเซิร์ฟเวอร์เท่านั้น
model SurveyAssignment {
  id          String    @id @default(cuid())
  waveId      String
  studentId   String
  eligibleAt  DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  wave    SurveyWave @relation(fields: [waveId], references: [id], onDelete: Cascade)
  student User       @relation("SurveyAssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([waveId, studentId])
  @@index([studentId, completedAt])
  @@index([waveId, completedAt])
}

model SurveyQuestion {
  id          String             @id @default(cuid())
  surveyId    String
  type        SurveyQuestionType
  prompt      String
  description String?
  isRequired  Boolean            @default(true)
  order       Int
  options     Json?
  minValue    Int?
  maxValue    Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@index([surveyId, order])
}

model SurveyResponse {
  id           String    @id @default(cuid())
  surveyId     String
  waveId       String
  studentId    String
  totalScore   Int?
  maxScore     Int       @default(0)
  scorePercent Int?
  riskLevel    RiskLevel @default(NORMAL)
  instrument   String?
  scoredAt     DateTime?
  submittedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  survey  Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  wave    SurveyWave @relation(fields: [waveId], references: [id], onDelete: Cascade)
  student User       @relation("SurveyResponseStudent", fields: [studentId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@unique([waveId, studentId])
  @@index([surveyId, submittedAt])
  @@index([waveId, submittedAt])
  @@index([studentId, submittedAt])
}

model SurveyAnswer {
  id         String   @id @default(cuid())
  responseId String
  questionId String
  value      Json
  createdAt  DateTime @default(now())

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([responseId, questionId])
  @@index([questionId])
}

/// ?????????????????????????????????????? (???????????????)
model StudentWellnessTrendSummary {
  id               String                  @id @default(cuid())
  studentId        String
  signalCode       WellnessTrendSignalCode
  occurrenceCount  Int                     @default(0)
  firstDetectedAt  DateTime
  lastDetectedAt   DateTime
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  student User @relation("WellnessTrendSummaryStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, signalCode])
  @@index([studentId, lastDetectedAt])
  @@index([signalCode, lastDetectedAt])
}

/// ???????????????????? (?????????????/????/????? ??????????????)
model StudentWellnessTrendHit {
  id          String                  @id @default(cuid())
  studentId   String
  signalCode  WellnessTrendSignalCode
  source      String
  detectedAt  DateTime                @default(now())

  student User @relation("WellnessTrendHitStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, signalCode, detectedAt])
  @@index([studentId, detectedAt])
  @@index([source, detectedAt])
}

/// สื่อประชาสัมพันธ์ที่แอดมินเพิ่ม/ลบได้ — แสดงหน้าแรกและหน้านิสิต
model SiteMediaItem {
  id              String        @id @default(cuid())
  slot            SiteMediaSlot
  title           String
  altText         String        @default("")
  /// ชื่อไฟล์ภายใต้ uploads/site-media (ไม่เก็บ path ออกนอก)
  imagePath       String
  href            String?
  ctaLabel        String?
  tag             String?
  summary         String?
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slot, isActive, sortOrder])
  @@index([createdByUserId])
}
