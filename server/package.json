{
  "name": "@nucare/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "build:vercel": "npm run build && prisma db seed",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "ghq28:seed": "tsx scripts/ensure-ghq28-survey.ts",
    "ghq28:recalculate": "tsx scripts/recalculate-ghq28-scores.ts",
    "orientation:seed-draft": "npm run ghq28:seed",
    "survey:backup": "tsx scripts/survey-backup.ts",
    "survey:smoke": "tsx scripts/survey-smoke-test.ts",
    "orientation:check": "tsx scripts/orientation-readiness.ts",
    "test:db:up": "docker compose -f ../docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f ../docker-compose.test.yml down -v",
    "test:db:migrate": "tsx scripts/run-test-migrate.ts",
    "test:unit": "tsx --test src/lib/survey-scoring.test.ts src/lib/executive-analytics.test.ts src/lib/executive-screening-comparison.test.ts",
    "test:sqa": "tsx scripts/ghq28-sqa-test.ts",
    "test:sqa:all": "npm run test:db:up && npm run test:db:migrate && npm run test:unit && npm run test:sqa"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express-rate-limit": "^7.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.5",
    "prisma": "^6.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.2"
  }
}
