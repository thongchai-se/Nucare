# คัดลอกเป็น .env.faculty บนเซิร์ฟเวอร์คณะ (อย่า commit ไฟล์จริง)
# ./scripts/check-faculty-deploy.sh
# docker compose -p nucare --env-file .env.faculty -f docker-compose.faculty.yml up -d --build

# --- Database (ชื่ออย่างเดียว — รหัสผ่านอยู่ใน secret file) ---
NUCARE_POSTGRES_DB=nucare
NUCARE_POSTGRES_USER=nucare

# --- Public origin (HTTP ชั่วคราวที่ port 89) ---
# เมื่อ faculty Nginx + HTTPS พร้อม: เปลี่ยนเป็น https://your-domain
# แล้วตั้ง NUCARE_AUTH_COOKIE_SECURE=true และ rebuild client
NUCARE_PUBLIC_APP_ORIGIN=http://10.101.111.160:89
NUCARE_CLIENT_PORT=89

# เข้าตรง :89 = 0 / ผ่าน faculty reverse proxy = 1
NUCARE_TRUST_PROXY_HOPS=0

# HTTP ชั่วคราวต้องเป็น false; เปิด true เมื่อมี HTTPS จริง
NUCARE_AUTH_COOKIE_SECURE=false

# --- Email (ยังไม่มี SMTP) ---
NUCARE_EMAIL_PROVIDER=console
NUCARE_ALLOW_CONSOLE_EMAIL=true
# เมื่อได้ SMTP ให้ตั้ง:
# NUCARE_EMAIL_PROVIDER=smtp
# NUCARE_ALLOW_CONSOLE_EMAIL=false
# NUCARE_SMTP_HOST=
# NUCARE_SMTP_PORT=587
# NUCARE_SMTP_SECURE=false
# NUCARE_SMTP_USER=
# NUCARE_SMTP_FROM=

# --- Chat (KKU Gen AI) — API key อยู่ใน secret file เท่านั้น ---
NUCARE_CHAT_PROVIDER=kku
NUCARE_KKU_GEN_BASE_URL=https://gen.ai.kku.ac.th/api/v1
NUCARE_KKU_GEN_CHAT_MODEL=gemini-3.8-flash

# --- Secret file paths (สร้างบนเซิร์ฟเวอร์; อย่าใส่ค่า secret ในไฟล์นี้) ---
NUCARE_POSTGRES_PASSWORD_SECRET_FILE=./secrets/faculty/postgres_password.txt
NUCARE_DATABASE_URL_SECRET_FILE=./secrets/faculty/database_url.txt
NUCARE_JWT_ACCESS_SECRET_FILE=./secrets/faculty/jwt_access_secret.txt
NUCARE_JWT_REFRESH_SECRET_FILE=./secrets/faculty/jwt_refresh_secret.txt
NUCARE_AI_API_KEY_SECRET_FILE=./secrets/faculty/ai_api_key.txt
